# Normalisation des fins de ligne. Indispensable quand le dépôt est alimenté
# depuis Windows et consommé sous Linux : sans ça, un contrôle comparant des
# octets casse de façon incompréhensible.
* text=auto eol=lf

# Doivent rester en LF quoi qu'il arrive
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
Makefile text eol=lf
*.sh text eol=lf
# Sans extension, et sans ça le shebang d'un AppRun en CRLF rend un
# « bad interpreter » que rien ne relie à un problème de fins de ligne.
AppRun text eol=lf
*.desktop text eol=lf
# Inno Setup lit un `.iss` en UTF-8 **à condition d'y trouver un BOM** ; sans
# lui il l'interprète en ANSI et les accents deviennent du charabia dans le nom
# du programme. Le BOM se garde donc, et la déclaration empêche une
# normalisation de le retirer.
*.iss text eol=crlf

# Spécifiques Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaire, jamais converti. Les planches et les sons sont comparés octet pour
# octet à ce que la chaîne réengendre : s'en remettre à l'heuristique de
# `text=auto` ferait dépendre le contrôle d'une détection au lieu d'une
# déclaration.
*.png binary
*.ico binary
*.ttf binary
*.webp binary
*.wav binary
*.ogg binary
*.flac binary
*.glb binary
*.world binary
*.mesh binary
*.bin binary
*.zip binary
*.gz binary
*.exe binary
